{
  "name": "somite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "workspaces": [
    "web",
    "runner",
    "packages/*"
  ],
  "scripts": {
    "app": "npm start",
    "build": "npm run build --workspace=somite-web",
    "check:version": "node --experimental-strip-types scripts/check-version-contract.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "node --experimental-strip-types scripts/somite-web.ts",
    "dev:web": "npm run dev --workspace=somite-web",
    "lint": "npm run lint --workspace=somite-web",
    "smoke:browser": "node --experimental-strip-types --test --test-concurrency=1 runner/tests/production-browser.acceptance.ts",
    "smoke:release": "node --experimental-strip-types --test --test-concurrency=1 runner/tests/production-launcher.smoke.ts runner/tests/pixi-nextflow.smoke.ts",
    "start": "node --experimental-strip-types scripts/somite-web.ts --production",
    "start:runner": "npm run start --workspace=somite-runner",
    "test": "npm run check:version && npm run test --workspace=@somite/workflow && npm run test --workspace=somite-runner && npm run test --workspace=somite-web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "playwright-core": "1.62.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
