{
  "name": "somite-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/graph-interactions.test.ts tests/agent-state.test.ts tests/agent-frame.test.ts tests/readiness-state.test.ts tests/canvas-presentation.test.ts tests/catalog-expansion.test.ts tests/paper-resolution.test.ts tests/paper-intake.test.ts tests/paper-reading.test.ts tests/source-workflow-presentation.test.ts tests/source-workflow-network.test.ts tests/graph-persistence.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "12.11.5",
    "lucide-react": "^1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.0",
    "@cloudflare/workers-types": "5.20260826.1",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "10.9.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.126.0"
  },
  "type": "module"
}
