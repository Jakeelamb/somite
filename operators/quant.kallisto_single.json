{
  "id": "quant.kallisto_single",
  "title": "Kallisto single-end",
  "palette": ["RNA"],
  "paper": {
    "aliases": [],
    "operation_class": "transcript_quantification",
    "assays": ["rna-seq"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "kallisto",
  "pixi": ["bioconda::kallisto=0.52.0"],
  "params": {
    "fragment_length": { "type": "float", "label": "Mean fragment length", "page": "Single-end library", "required": true, "min": 1 },
    "fragment_sd": { "type": "float", "label": "Fragment-length standard deviation", "page": "Single-end library", "required": true, "min": 0 },
    "threads": { "type": "int", "label": "Threads", "page": "Kallisto", "default": 4, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "reads", "type": "Fastq", "union": ["Fastq", "FastqGz"] },
      {
        "name": "index",
        "type": "Directory",
        "stage_as": "kallisto_index",
        "resource": {
          "profile": "kallisto-transcriptome-index",
          "title": "Kallisto transcriptome index",
          "detail": "Connect a Kallisto index built from the exact transcript sequences being quantified.",
          "resolutions": [
            {
              "id": "build-from-transcript-fasta",
              "label": "Build from transcript FASTA",
              "detail": "Add Build Kallisto transcriptome index and connect a transcript FASTA, not a genomic assembly FASTA.",
              "kind": "build",
              "recommended": true,
              "source_url": "https://pachterlab.github.io/kallisto/manual"
            }
          ]
        }
      }
    ],
    "out": [
      { "name": "abundance", "type": "Table" },
      { "name": "run_info", "type": "Json" }
    ]
  },
  "argv": [
    "kallisto", "quant",
    "--index", "{input.index}/transcripts.idx",
    "--output-dir", "{work}/out",
    "--threads", "{param.threads}",
    "--single",
    "--fragment-length", "{param.fragment_length}",
    "--sd", "{param.fragment_sd}",
    "{input.reads}"
  ],
  "outputs": {
    "abundance": { "glob": "{work}/out/abundance.tsv", "type": "Table" },
    "run_info": { "glob": "{work}/out/run_info.json", "type": "Json" }
  }
}
