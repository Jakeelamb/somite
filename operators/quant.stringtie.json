{
  "id": "quant.stringtie",
  "title": "StringTie",
  "palette": ["RNA"],
  "paper": {
    "aliases": ["StringTie"],
    "operation_class": "transcript_assembly",
    "assays": ["rna-seq"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "stringtie",
  "pixi": ["bioconda::stringtie"],
  "ports": {
    "in": [
      { "name": "bam", "type": "Bam" },
      { "name": "gtf", "type": "Gtf", "union": ["Gtf", "GtfGz"], "optional": true }
    ],
    "out": [{ "name": "abund", "type": "Gtf" }]
  },
  "argv": [
    "stringtie",
    "{input.bam}",
    "?gtf:-G", "?gtf:{input.gtf}",
    "-o", "{work}/out/transcripts.gtf"
  ],
  "outputs": {
    "abund": { "glob": "{work}/out/transcripts.gtf", "type": "Gtf" }
  }
}
