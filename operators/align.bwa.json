{
  "id": "align.bwa",
  "title": "BWA-MEM",
  "palette": ["Variants"],
  "kind": "external",
  "cost": "high",
  "bin": "bwa",
  "pixi": ["bioconda::bwa"],
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "BWA", "default": 8, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "r1", "type": "Fastq", "union": ["Fastq", "FastqGz"] },
      { "name": "r2", "type": "Fastq", "union": ["Fastq", "FastqGz"], "optional": true },
      { "name": "ref", "type": "Fasta", "union": ["Fasta", "FastaGz"] }
    ],
    "out": [{ "name": "sam", "type": "Sam" }]
  },
  "argv": [
    "bwa", "mem",
    "-t", "{param.threads}",
    "{input.ref}",
    "{input.r1}",
    "{input.r2}"
  ],
  "outputs": {
    "sam": { "glob": "{work}/out/aligned.sam", "type": "Sam" }
  },
  "stdout": "sam"
}
