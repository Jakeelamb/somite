{
  "id": "align.bwa",
  "title": "BWA-MEM",
  "palette": ["Variants"],
  "paper": {
    "aliases": ["BWA-MEM", "BWA MEM"],
    "operation_class": "read_alignment",
    "assays": ["assembly", "variants"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "bwa",
  "pixi": ["bioconda::bwa"],
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "BWA", "default": 8, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "r1", "type": "Fastq", "union": ["Fastq", "FastqGz"] },
      { "name": "r2", "type": "Fastq", "union": ["Fastq", "FastqGz"], "optional": true },
      {
        "name": "index",
        "type": "Directory",
        "stage_as": "bwa_index",
        "resource": {
          "profile": "bwa-index",
          "title": "BWA index",
          "detail": "Connect an index built from the same reference assembly you want to align against.",
          "resolutions": [
            {
              "id": "build-from-fasta",
              "label": "Build from FASTA",
              "detail": "Add Build BWA index and connect a reference FASTA.",
              "kind": "build",
              "recommended": true
            }
          ]
        }
      }
    ],
    "out": [{ "name": "sam", "type": "Sam" }]
  },
  "argv": [
    "bwa", "mem",
    "-t", "{param.threads}",
    "{input.index}/index",
    "{input.r1}",
    "?r2:{input.r2}"
  ],
  "outputs": {
    "sam": { "glob": "{work}/out/aligned.sam", "type": "Sam" }
  },
  "stdout": "sam"
}
