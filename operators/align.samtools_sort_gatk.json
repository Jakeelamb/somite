{
  "id": "align.samtools_sort_gatk",
  "title": "Coordinate-sort read-grouped BAM",
  "palette": ["Alignment preparation"],
  "kind": "external",
  "cost": "low",
  "bin": "samtools",
  "pixi": ["bioconda::samtools"],
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "Sort", "default": 4, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [{ "name": "bam", "type": "ReadGroupedBam" }],
    "out": [{ "name": "bam", "type": "GatkReadyBam" }]
  },
  "argv": [
    "samtools", "sort", "-@", "{param.threads}",
    "-o", "{work}/out/sorted.bam", "{input.bam}"
  ],
  "outputs": {
    "bam": { "glob": "{work}/out/sorted.bam", "type": "GatkReadyBam" }
  }
}
