{
  "id": "asm.yahs",
  "title": "YaHS",
  "palette": ["Assembly"],
  "paper": {
    "aliases": ["YaHS"],
    "operation_class": "genome_scaffolding",
    "assays": ["assembly"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "yahs",
  "pixi": ["bioconda::yahs"],
  "ports": {
    "in": [
      { "name": "contigs", "type": "Fasta", "union": ["Fasta", "FastaGz"] },
      { "name": "hic", "type": "Bam" }
    ],
    "out": [{ "name": "scaffolds", "type": "Fasta" }]
  },
  "argv": [
    "yahs",
    "{input.contigs}",
    "{input.hic}",
    "-o", "{work}/out/yahs"
  ],
  "outputs": {
    "scaffolds": { "glob": "{work}/out/*.fa", "type": "Fasta" }
  }
}
