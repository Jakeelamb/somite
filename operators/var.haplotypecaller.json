{
  "id": "var.haplotypecaller",
  "title": "GATK HaplotypeCaller",
  "palette": ["Variants"],
  "paper": {
    "aliases": ["GATK HaplotypeCaller", "HaplotypeCaller"],
    "operation_class": "variant_calling",
    "assays": ["variants"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "gatk",
  "pixi": ["bioconda::gatk4"],
  "ports": {
    "in": [
      { "name": "bam", "type": "GatkReadyBam", "stage_as": "sample.bam" },
      { "name": "bai", "type": "Bai", "stage_as": "sample.bam.bai", "implicit_sidecar": true },
      { "name": "ref", "type": "Fasta", "stage_as": "reference.fa" },
      { "name": "fai", "type": "Fai", "stage_as": "reference.fa.fai", "implicit_sidecar": true },
      { "name": "dict", "type": "Dict", "stage_as": "reference.dict", "implicit_sidecar": true }
    ],
    "out": [{ "name": "vcf", "type": "Vcf" }]
  },
  "argv": [
    "gatk", "HaplotypeCaller",
    "-I", "{input.bam}",
    "-R", "{input.ref}",
    "-O", "{work}/out/calls.vcf"
  ],
  "outputs": {
    "vcf": { "glob": "{work}/out/calls.vcf", "type": "Vcf" }
  }
}
