{
  "id": "align.hisat2",
  "title": "HISAT2",
  "palette": ["RNA"],
  "kind": "external",
  "cost": "high",
  "bin": "hisat2",
  "conda": { "name": "axial-rna", "spec": ["bioconda::hisat2"] },
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "HISAT2", "default": 8, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "fastq", "type": "Fastq", "union": ["Fastq", "FastqGz"] },
      { "name": "index", "type": "Directory", "union": ["Directory", "Fasta", "FastaGz"], "optional": true }
    ],
    "out": [{ "name": "bam", "type": "Bam" }]
  },
  "argv": [
    "hisat2",
    "-p", "{param.threads}",
    "-x", "{input.index}",
    "-U", "{input.fastq}",
    "-S", "{work}/out/aln.sam"
  ],
  "outputs": {
    "bam": { "glob": "{work}/out/aln.sam", "type": "Bam", "optional": true }
  }
}
