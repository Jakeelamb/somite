{
  "id": "align.hisat2",
  "title": "HISAT2",
  "palette": ["RNA"],
  "paper": {
    "aliases": ["HISAT2"],
    "operation_class": "read_alignment",
    "assays": ["rna-seq"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "hisat2",
  "pixi": ["bioconda::hisat2"],
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "HISAT2", "default": 8, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "r1", "type": "Fastq", "union": ["Fastq", "FastqGz"] },
      { "name": "r2", "type": "Fastq", "union": ["Fastq", "FastqGz"], "optional": true },
      {
        "name": "index",
        "type": "Directory",
        "stage_as": "hisat2_index",
        "resource": {
          "profile": "hisat2-index",
          "title": "HISAT2 index",
          "detail": "Connect a HISAT2 index built from the reference genome used for this analysis.",
          "resolutions": [
            {
              "id": "build-from-fasta",
              "label": "Build from FASTA",
              "detail": "Add Build HISAT2 index and connect a reference FASTA.",
              "kind": "build",
              "recommended": true
            }
          ]
        }
      }
    ],
    "out": [{ "name": "sam", "type": "Sam" }]
  },
  "argv": [
    "hisat2",
    "-p", "{param.threads}",
    "-x", "{input.index}/index",
    "?r2:-1", "?r2:{input.r1}",
    "?r2:-2", "?r2:{input.r2}",
    "?!r2:-U", "?!r2:{input.r1}",
    "-S", "{work}/out/aln.sam"
  ],
  "outputs": {
    "sam": { "glob": "{work}/out/aln.sam", "type": "Sam" }
  }
}
