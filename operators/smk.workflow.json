{
  "id": "smk.workflow",
  "title": "Snakemake workflow",
  "palette": ["Snakemake", "Workflow"],
  "kind": "external",
  "cost": "high",
  "bin": "snakemake",
  "pixi": ["bioconda::snakemake-minimal"],
  "params": {
    "snakefile": { "type": "string", "label": "Snakefile", "page": "Workflow", "default": "workflow/Snakefile", "required": true },
    "cores": { "type": "int", "label": "Cores", "page": "Execution", "default": 4, "min": 1, "max": 256 },
    "dry_run": { "type": "bool", "label": "Dry run", "page": "Execution", "default": false },
    "keep_going": { "type": "bool", "label": "Keep going", "page": "Execution", "default": false },
    "printshellcmds": { "type": "bool", "label": "Print commands", "page": "Execution", "default": true }
  },
  "ports": {
    "in": [{ "name": "workflow", "type": "Directory" }],
    "out": [{ "name": "run", "type": "Directory" }]
  },
  "argv": [
    "snakemake",
    "--snakefile", "{input.workflow}/{param.snakefile}",
    "--directory", "{input.workflow}",
    "--cores", "{param.cores}",
    "{flag.dry_run}",
    "{flag.keep_going}",
    "{flag.printshellcmds}"
  ],
  "outputs": {
    "run": { "glob": "{input.workflow}", "type": "Directory" }
  }
}
