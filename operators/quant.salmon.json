{
  "id": "quant.salmon",
  "title": "Salmon",
  "palette": ["RNA"],
  "paper": {
    "aliases": ["Salmon"],
    "operation_class": "transcript_quantification",
    "assays": ["rna-seq"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "salmon",
  "pixi": ["bioconda::salmon"],
  "params": {
    "libtype": { "type": "string", "label": "Lib type", "page": "Salmon", "default": "A" }
  },
  "ports": {
    "in": [
      { "name": "r1", "type": "Fastq", "union": ["Fastq", "FastqGz"] },
      { "name": "r2", "type": "Fastq", "union": ["Fastq", "FastqGz"], "optional": true },
      {
        "name": "index",
        "type": "Directory",
        "stage_as": "salmon_index",
        "resource": {
          "profile": "salmon-index",
          "title": "Salmon transcriptome index",
          "detail": "Connect a Salmon index built from the transcript sequences you want to quantify.",
          "resolutions": [
            {
              "id": "build-from-transcript-fasta",
              "label": "Build from transcript FASTA",
              "detail": "Add Build Salmon transcriptome index and connect a transcript FASTA, not a genomic assembly FASTA.",
              "kind": "build",
              "recommended": true
            }
          ]
        }
      }
    ],
    "out": [{ "name": "quant", "type": "Table" }]
  },
  "argv": [
    "salmon", "quant",
    "-i", "{input.index}",
    "-l", "{param.libtype}",
    "?r2:-1", "?r2:{input.r1}",
    "?r2:-2", "?r2:{input.r2}",
    "?!r2:-r", "?!r2:{input.r1}",
    "-o", "{work}/out"
  ],
  "outputs": {
    "quant": { "glob": "{work}/out/quant.sf", "type": "Table" }
  }
}
