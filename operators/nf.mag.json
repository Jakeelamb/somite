{
  "id": "nf.mag",
  "title": "nf-core/mag",
  "palette": ["nf-core", "Metagenomics"],
  "kind": "external",
  "cost": "high",
  "bin": "nextflow",
  "pixi": ["bioconda::nextflow"],
  "params": {
    "revision": { "type": "string", "label": "Version", "page": "Pipeline", "default": "5.5.0" }
  },
  "ports": {
    "in": [{ "name": "sheet", "type": "Table" }],
    "out": [{ "name": "results", "type": "Directory", "optional": true }]
  },
  "argv": [
    "nextflow", "run", "nf-core/mag", "-r", "{param.revision}",
    "--input", "{input.sheet}", "--outdir", "{work}/out"
  ],
  "outputs": {
    "results": { "glob": "{work}/out", "type": "Directory", "optional": true }
  }
}
