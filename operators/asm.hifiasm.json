{
  "id": "asm.hifiasm",
  "title": "hifiasm",
  "palette": ["Assembly"],
  "paper": {
    "aliases": ["hifiasm"],
    "operation_class": "genome_assembly",
    "assays": ["assembly"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "hifiasm",
  "pixi": ["bioconda::hifiasm"],
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "hifiasm", "default": 8, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "reads", "type": "Fastq", "union": ["Fastq", "FastqGz", "Fasta", "FastaGz"] }
    ],
    "out": [{ "name": "asm", "type": "Directory" }]
  },
  "argv": ["hifiasm", "-t", "{param.threads}", "-o", "{work}/out/asm", "{input.reads}"],
  "outputs": {
    "asm": { "glob": "{work}/out", "type": "Directory" }
  }
}
