{
  "id": "align.star",
  "title": "STAR",
  "palette": ["RNA"],
  "paper": {
    "aliases": ["STAR"],
    "operation_class": "read_alignment",
    "assays": ["rna-seq"]
  },
  "kind": "external",
  "cost": "high",
  "bin": "STAR",
  "pixi": ["bioconda::star"],
  "params": {
    "threads": { "type": "int", "label": "Threads", "page": "STAR", "default": 8, "min": 1, "max": 64 }
  },
  "ports": {
    "in": [
      { "name": "r1", "type": "Fastq" },
      { "name": "r2", "type": "Fastq", "optional": true },
      {
        "name": "genome",
        "type": "Directory",
        "stage_as": "star_index",
        "resource": {
          "profile": "star-index",
          "title": "STAR genome index",
          "detail": "Connect a STAR index built from the reference genome used for this analysis.",
          "resolutions": [
            {
              "id": "build-from-fasta",
              "label": "Build from FASTA",
              "detail": "Add Build STAR index and connect an uncompressed reference FASTA.",
              "kind": "build",
              "recommended": true
            }
          ]
        }
      }
    ],
    "out": [{ "name": "bam", "type": "Bam", "resource_profile": "coordinate-sorted-bam" }]
  },
  "argv": [
    "STAR",
    "--runThreadN", "{param.threads}",
    "--genomeDir", "{input.genome}",
    "--readFilesIn", "{input.r1}", "?r2:{input.r2}",
    "--outFileNamePrefix", "{work}/out/star",
    "--outSAMtype", "BAM", "SortedByCoordinate"
  ],
  "outputs": {
    "bam": { "glob": "{work}/out/*.bam", "type": "Bam" }
  }
}
